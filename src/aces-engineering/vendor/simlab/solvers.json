          },
          "rig_fp64_gpu7": {
            "compliance_Nmm": 202.03,
            "wall_s": 56.25,
            "device": "NVIDIA CMP 170HX"
          },
          "note": "identical topology on both machines (docs/BENCHMARKS.md)"
